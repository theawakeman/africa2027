    <ExtendedData><SchemaData schemaUrl="#a27schema"><SimpleData name="categoria">Hospital</SimpleData></SchemaData></ExtendedData>
    <Point><coordinates>-12.151,12.53777,0</coordinates></Point>
  </Placemark>
  <Placemark>
    <name>Centre de santé de Ranérou</name>
    <description><![CDATA[<b>Hospital</b><br/>Capacidad limitada; coordenada provisional; no sustituye evacuación.<br/><a href="https://theawakeman.github.io/africa2027/paises/senegal/#logistica">Ver ficha completa</a> · <a href="https://www.google.com/maps?q=15.29808,-13.96239">Google Maps</a>]]></description>
