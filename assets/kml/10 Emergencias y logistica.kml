    <Point><coordinates>-13.0521,20.52214,0</coordinates></Point>
  </Placemark>
  <Placemark>
    <name>Hôpital de la Fraternité — Chinguetti</name>
    <description><![CDATA[<b>Hospital</b><br/>Centro local relevante en el itinerario interior.<br/><a href="https://theawakeman.github.io/africa2027/paises/mauritania/#logistica">Ver ficha completa</a> · <a href="https://www.google.com/maps?q=20.46379,-12.36812">Google Maps</a>]]></description>
