  <Placemark>
    <name>Centre Hospitalier National — Nuakchot</name>
    <description><![CDATA[<b>Hospital</b><br/>Hospital público de referencia; capacidad limitada para casos complejos.<br/><a href="https://theawakeman.github.io/africa2027/paises/mauritania/#logistica">Ver ficha completa</a> · <a href="https://www.google.com/maps?q=18.08806,-15.98798">Google Maps</a>]]></description>
