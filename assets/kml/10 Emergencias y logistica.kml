  </Placemark>
  <Placemark>
    <name>Paso Karang–Amdalai — Senegal/Gambia (SUBIDA)</name>
    <description><![CDATA[<b>Frontera</b><br/>Paso del corredor de SUBIDA: se cruza a Gambia a la vuelta, viniendo de Casamance, para subir después hacia Dakar y el lago Retba. Ver la ficha de Gambia.<br/><a href="https://theawakeman.github.io/africa2027/paises/senegal/#logistica">Ver ficha completa</a> · <a href="https://www.google.com/maps?q=13.59169,-16.42208">Google Maps</a>]]></description>
    <styleUrl>#icon-frontera</styleUrl>
    <ExtendedData><SchemaData schemaUrl="#a27schema"><SimpleData name="categoria">Frontera</SimpleData></SchemaData></ExtendedData>
    <Point><coordinates>-16.42208,13.59169,0</coordinates></Point>
  </Placemark>
  <Placemark>
    <name>Paso Keur Ayib–Farafenni — Senegal/Gambia (SUBIDA)</name>
    <description><![CDATA[<b>Frontera</b><br/>Paso de la variante interior de Gambia, junto al puente de Senegambia, si a la vuelta se remonta el río en vez de tomar el eje corto costero.<br/><a href="https://theawakeman.github.io/africa2027/paises/senegal/#logistica">Ver ficha completa</a> · <a href="https://www.google.com/maps?q=13.59335,-15.60578">Google Maps</a>]]></description>
    <styleUrl>#icon-frontera</styleUrl>
    <ExtendedData><SchemaData schemaUrl="#a27schema"><SimpleData name="categoria">Frontera</SimpleData></SchemaData></ExtendedData>
    <Point><coordinates>-15.60578,13.59335,0</coordinates></Point>
  </Placemark>
  <Placemark>
