    <Point><coordinates>-17.04444,20.92879,0</coordinates></Point>
  </Placemark>
  <Placemark>
    <name>Centre Hospitalier d'Atar</name>
    <description><![CDATA[<b>Hospital</b><br/>Recurso sanitario urbano para el bloque del Adrar; no sustituye seguro de evacuación.<br/><a href="https://theawakeman.github.io/africa2027/paises/mauritania/#logistica">Ver ficha completa</a> · <a href="https://www.google.com/maps?q=20.52214,-13.0521">Google Maps</a>]]></description>
