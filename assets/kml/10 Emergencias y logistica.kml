    <ExtendedData><SchemaData schemaUrl="#a27schema"><SimpleData name="categoria">Consulado</SimpleData></SchemaData></ExtendedData>
    <Point><coordinates>38.76,9.028,0</coordinates></Point>
  </Placemark>
  <Placemark>
    <name>Black Lion Hospital, Adís Abeba</name>
    <description><![CDATA[<b>Hospital</b><br/>Principal hospital de referencia del país; mejor opción sanitaria del tramo junto con clínicas privadas de la capital.<br/><a href="https://theawakeman.github.io/africa2027/paises/etiopia/#logistica">Ver ficha completa</a> · <a href="https://www.google.com/maps?q=9.035,38.75">Google Maps</a>]]></description>
