    <Point><coordinates>34.29803,-12.93149,0</coordinates></Point>
  </Placemark>
  <Placemark>
    <name>Senga Bay y Salima</name>
    <description><![CDATA[<img src="https://commons.wikimedia.org/wiki/Special:FilePath/Senga_Bay_Fischerdorf.jpg?width=1200" width="320"/><br/><b>Media · Costa</b><br/>Bahía de arena junto al lago Malaui y base de descanso cerca de Salima. El pin coincide con Senga Bay y no con una playa genérica de otra parte del lago.<br/><b>Perro:</b> confirmar con alojamiento<br/><a href="https://theawakeman.github.io/africa2027/paises/malaui/#poi-11">Ver ficha completa</a> · <a href="https://www.google.com/maps?q=-13.75195,34.6165">Google Maps</a>]]></description>
    <styleUrl>#icon-poi-turquesa</styleUrl>
