    <Point><coordinates>-16.5719,13.5772,0</coordinates></Point>
  </Placemark>
  <Placemark>
    <name>Kotu Beach / Serrekunda (costa turística)</name>
    <description><![CDATA[<img src="https://commons.wikimedia.org/wiki/Special:FilePath/Kotu%20Beach%2C%20The%20Gambia%20(16197149546).jpg?width=900" width="320"/><br/><b>Media · Naturaleza</b><br/>Franja costera atlántica de la Gambia turística, con buena oferta hotelera y observación de aves; Serrekunda, la mayor ciudad del país, concentra los mercados y servicios más completos.<br/><b>Perro:</b> permitido con condiciones<br/><a href="https://theawakeman.github.io/africa2027/paises/gambia/#poi-2">Ver ficha completa</a> · <a href="https://www.google.com/maps?q=13.4526,-16.7069">Google Maps</a>]]></description>
