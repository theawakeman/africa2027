    <Point><coordinates>27.5,-29.6333,0</coordinates></Point>
  </Placemark>
  <Placemark>
    <name>Malealea</name>
    <description><![CDATA[<b>Alta · Cultura</b><br/>Una vieja tienda comercial de 1905 convertida en lodge en un valle de montaña, y el sitio donde la mayoría de los viajeros descubre el LESOTO A CABALLO: los ponis basotho, pequeños, duros y criados para estas laderas, so<br/><b>Perro:</b> por confirmar<br/><a href="https://theawakeman.github.io/africa2027/paises/lesoto/#poi-17">Ver ficha completa</a> · <a href="https://www.google.com/maps?q=-29.85,27.6167">Google Maps</a>]]></description>
    <styleUrl>#icon-poi-morado</styleUrl>
    <ExtendedData><SchemaData schemaUrl="#a27schema"><SimpleData name="categoria">PDI · Morado</SimpleData></SchemaData></ExtendedData>
