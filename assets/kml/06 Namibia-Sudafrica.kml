    <Point><coordinates>28.61878,-28.50629,0</coordinates></Point>
  </Placemark>
  <Placemark>
    <name>Sani Pass</name>
    <description><![CDATA[<img src="https://commons.wikimedia.org/wiki/Special:FilePath/Sani_Pass_heading_into_Lesotho.jpg?width=1200" width="320"/><br/><b>Alta · Naturaleza</b><br/>Sani Pass es una pista de alta montaña y frontera con Lesoto. El pin marca el paso, no el control sudafricano ni un permiso de cruce.<br/><b>Perro:</b> permitido con condiciones<br/><a href="https://theawakeman.github.io/africa2027/paises/sudafrica/#poi-11">Ver ficha completa</a> · <a href="https://www.google.com/maps?q=-29.58798,29.2922">Google Maps</a>]]></description>
    <styleUrl>#icon-poi-verde</styleUrl>
    <ExtendedData><SchemaData schemaUrl="#a27schema"><SimpleData name="categoria">PDI · Verde</SimpleData></SchemaData></ExtendedData>
    <Point><coordinates>29.2922,-29.58798,0</coordinates></Point>
  </Placemark>
  <Placemark>
    <name>Hole-in-the-Wall</name>
    <description><![CDATA[<img src="https://commons.wikimedia.org/wiki/Special:FilePath/Hole_in_the_Wall_-_South_Africa_(2418545120).jpg?width=1200" width="320"/><br/><b>Alta · Costa</b><br/>Arco natural separado de la costa cerca del poblado Hole-in-the-Wall. La aproximación por la Wild Coast requiere tiempo y criterio local.<br/><b>Perro:</b> permitido con condiciones<br/><a href="https://theawakeman.github.io/africa2027/paises/sudafrica/#poi-12">Ver ficha completa</a> · <a href="https://www.google.com/maps?q=-32.04123,29.10926">Google Maps</a>]]></description>
    <styleUrl>#icon-poi-turquesa</styleUrl>
    <ExtendedData><SchemaData schemaUrl="#a27schema"><SimpleData name="categoria">PDI · Turquesa</SimpleData></SchemaData></ExtendedData>
    <Point><coordinates>29.10926,-32.04123,0</coordinates></Point>
  </Placemark>
  <Placemark>
    <name>Tsitsikamma · Storms River Mouth</name>
    <description><![CDATA[<img src="https://commons.wikimedia.org/wiki/Special:FilePath/Storms_river_mouth_rest_camp_(32517159604).jpg?width=1200" width="320"/><br/><b>Alta · Costa</b><br/>Storms River Mouth Rest Camp es la base costera de Tsitsikamma y el acceso a pasarelas y al inicio del Otter Trail.<br/><b>Perro:</b> permitido con condiciones<br/><a href="https://theawakeman.github.io/africa2027/paises/sudafrica/#poi-13">Ver ficha completa</a> · <a href="https://www.google.com/maps?q=-34.02318,23.89601">Google Maps</a>]]></description>
