  </Placemark>
  <Placemark>
    <name>Augrabies Falls</name>
    <description><![CDATA[<img src="https://commons.wikimedia.org/wiki/Special:FilePath/Augrabies_Falls,_March_2008.jpg?width=1200" width="320"/><br/><b>Media · Naturaleza</b><br/>El mirador de Augrabies Falls muestra al Orange River encajonado en granito. Caudal, ruido y aspecto cambian mucho con la estación.<br/><b>Perro:</b> prohibido<br/><a href="https://theawakeman.github.io/africa2027/paises/sudafrica/#poi-24">Ver ficha completa</a> · <a href="https://www.google.com/maps?q=-28.59128,20.34008">Google Maps</a>]]></description>
    <styleUrl>#icon-poi-verde</styleUrl>
    <ExtendedData><SchemaData schemaUrl="#a27schema"><SimpleData name="categoria">PDI · Verde</SimpleData></SchemaData></ExtendedData>
    <Point><coordinates>20.34008,-28.59128,0</coordinates></Point>
  </Placemark>
  <Placemark>
    <name>Namaqua · Skilpad Rest Camp</name>
    <description><![CDATA[<img src="https://commons.wikimedia.org/wiki/Special:FilePath/Namaqua_banner.jpg?width=1200" width="320"/><br/><b>Alta · Naturaleza</b><br/>Skilpad Rest Camp es la base del sector de flores de Namaqua. La floración depende de lluvia, temperatura, sol y viento: no tiene fecha garantizada.<br/><b>Perro:</b> prohibido<br/><a href="https://theawakeman.github.io/africa2027/paises/sudafrica/#poi-25">Ver ficha completa</a> · <a href="https://www.google.com/maps?q=-30.16326,17.77806">Google Maps</a>]]></description>
    <styleUrl>#icon-poi-verde</styleUrl>
    <ExtendedData><SchemaData schemaUrl="#a27schema"><SimpleData name="categoria">PDI · Verde</SimpleData></SchemaData></ExtendedData>
    <Point><coordinates>17.77806,-30.16326,0</coordinates></Point>
  </Placemark>
  <Placemark>
    <name>Richtersveld · Sendelingsdrift</name>
    <description><![CDATA[<img src="https://commons.wikimedia.org/wiki/Special:FilePath/Richtersveld_World_Heritage_Site,_Mountain_scene_near_Kuboes.JPG?width=1200" width="320"/><br/><b>Alta · Patrimonio UNESCO</b><br/>Sendelingsdrift es la recepción y acceso del Richtersveld junto al Orange. El transbordador internacional a Namibia puede no operar.<br/><b>Perro:</b> prohibido<br/><a href="https://theawakeman.github.io/africa2027/paises/sudafrica/#poi-26">Ver ficha completa</a> · <a href="https://www.google.com/maps?q=-28.1252,16.89122">Google Maps</a>]]></description>
