    <ExtendedData><SchemaData schemaUrl="#a27schema"><SimpleData name="categoria">PDI · Azul</SimpleData></SchemaData></ExtendedData>
    <Point><coordinates>28.00837,-26.23787,0</coordinates></Point>
  </Placemark>
  <Placemark>
    <name>Mandela House · Soweto</name>
    <description><![CDATA[<img src="https://commons.wikimedia.org/wiki/Special:FilePath/Soweto,_Mandela_House_(2).jpg?width=1200" width="320"/><br/><b>Alta · Cultura</b><br/>La casa de Vilakazi Street donde vivió Nelson Mandela es hoy un museo pequeño dentro de un barrio vivo, no una síntesis completa de Soweto.<br/><b>Perro:</b> prohibido<br/><a href="https://theawakeman.github.io/africa2027/paises/sudafrica/#poi-2">Ver ficha completa</a> · <a href="https://www.google.com/maps?q=-26.23853,27.90881">Google Maps</a>]]></description>
