    <ExtendedData><SchemaData schemaUrl="#a27schema"><SimpleData name="categoria">PDI · Verde</SimpleData></SchemaData></ExtendedData>
    <Point><coordinates>10.1,2.3667,0</coordinates></Point>
  </Placemark>
  <Placemark>
    <name>Sangmélima</name>
    <description><![CDATA[<img src="https://commons.wikimedia.org/wiki/Special:FilePath/Yaoundé%201.jpg?width=900" width="320"/><br/><b>Media · Ciudad · servicios</b><br/>Capital del departamento de Dja-et-Lobo y ÚLTIMA plaza de servicios reales (combustible formal, taller, hospital, banco, mercado) antes de los 325 km del corredor Ketta-Djoum hacia la frontera del Congo. Punto de no reto<br/><b>Perro:</b> permitido con condiciones<br/><a href="https://theawakeman.github.io/africa2027/paises/camerun/#poi-9">Ver ficha completa</a> · <a href="https://www.google.com/maps?q=2.9333,11.9833">Google Maps</a>]]></description>
