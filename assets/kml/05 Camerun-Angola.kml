    <ExtendedData><SchemaData schemaUrl="#a27schema"><SimpleData name="categoria">PDI · Morado</SimpleData></SchemaData></ExtendedData>
    <Point><coordinates>15.286,-4.335,0</coordinates></Point>
  </Placemark>
  <Placemark>
    <name>Luanda</name>
    <description><![CDATA[<img src="https://commons.wikimedia.org/wiki/Special:FilePath/2009%20Luanda%20Angola%203818325721.jpg?width=900" width="320"/><br/><b>Alta · Ciudad · servicios</b><br/>Capital y mayor base logística del país: puerto, aeropuerto internacional, embajada de España, talleres y recambios de todo tipo. Marginal (paseo marítimo), Fortaleza de San Miguel y el Museo Nacional de Antropología com<br/><b>Perro:</b> permitido con condiciones<br/><a href="https://theawakeman.github.io/africa2027/paises/angola/#poi-1">Ver ficha completa</a> · <a href="https://www.google.com/maps?q=-8.8383,13.2344">Google Maps</a>]]></description>
