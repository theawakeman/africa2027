          <Data name="gx_media_links">
            <value>https://mymaps.usercontent.google.com/hostedimage/m/*/3AAjQbR7f36C-eISmNJPIoH6c_f4b-37L-spnowvKZ6u0f9eZKBczKq_Cx-ppY_yCfu9r0w3ddnNGCqPItsJX3nk5DL8dLiH3fUS3g19M6c6Hy3HvtfmcJfC-uw2AnBM2QU4E8nGgcoQQdZgl8Vk_0Tkrgztlwh8BqaCOvgb8l2AEWH1Zjozzrca5CXlV5LYBeQK6UVsSu3QPPdJyPGNdPdccRQTA0ao1jqxv0b0nEyz1oWtixU5iHiymR9W0IBg?fife=s16383</value>
          </Data>
        </ExtendedData>
        <Point>
          <coordinates>
            -12.381775,12.526554,0
          </coordinates>
